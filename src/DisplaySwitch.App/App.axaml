<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DisplaySwitch.App.App"
             Name="DisplaySwitch"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DisplaySwitch/Design/Tokens.axaml" />
        <ResourceInclude Source="avares://DisplaySwitch/Design/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent controls (toggles, text boxes, list selection) take the brand accent from these palettes. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#5B4CF0" />
        <ColorPaletteResources x:Key="Dark" Accent="#A99CFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://DisplaySwitch/Design/Styles.axaml" />
  </Application.Styles>
</Application>
