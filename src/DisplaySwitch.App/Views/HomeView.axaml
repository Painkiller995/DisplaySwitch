<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DisplaySwitch.App.ViewModels"
             xmlns:views="using:DisplaySwitch.App.Views"
             xmlns:controls="using:DisplaySwitch.App.Controls"
             xmlns:conv="using:DisplaySwitch.App.Converters"
             x:Class="DisplaySwitch.App.Views.HomeView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <!-- The customize button is quiet until the card is hovered or focused. -->
    <Style Selector="Button.cardMenu">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.inputCard:pointerover Button.cardMenu, Button.cardMenu:focus-visible">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Panel>
      <!-- ============ First scan ============ -->
      <StackPanel IsVisible="{Binding !Workspace.HasScanned}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="0,120,0,0">
        <controls:Spinner Width="28" Height="28" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" IsVisible="{Binding !Workspace.HasScanned}" />
        <TextBlock Classes="secondary" Text="Looking for monitors…" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- ============ Nothing found ============ -->
      <StackPanel IsVisible="{Binding Workspace.ShowEmptyState}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="12" Margin="24,96,24,24">
        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource Brush.SurfaceSunken}" HorizontalAlignment="Center">
          <controls:Icon Data="{StaticResource Icon.Desktop}" Width="30" Height="30" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
        <TextBlock Classes="title" Text="No monitors found" HorizontalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock Classes="paragraph" TextAlignment="Center"
                   Text="{Binding Workspace.PlatformProblem, FallbackValue='Connect a monitor and make sure DDC/CI is turned on in its on-screen menu.', TargetNullValue='Connect a monitor and make sure DDC/CI is turned on in its on-screen menu.'}" />
        <Button Classes="primary" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding Workspace.RefreshCommand}" Content="Search again" />
      </StackPanel>

      <!-- ============ Selected monitor ============ -->
      <StackPanel IsVisible="{Binding Workspace.HasMonitors}" Margin="{StaticResource Space.PagePadding}" MaxWidth="880">
        <views:MonitorHero DataContext="{Binding Workspace.SelectedMonitor}" Margin="0,12,0,0" />

        <StackPanel HorizontalAlignment="Center" Margin="0,22,0,0" Spacing="4">
          <TextBlock Classes="title" Text="{Binding Workspace.SelectedMonitor.DisplayName, FallbackValue=''}" HorizontalAlignment="Center" />
          <TextBlock Classes="caption" Text="{Binding Workspace.SelectedMonitor.Details, FallbackValue=''}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- App notices, platform problems, unsupported monitor, last switch result.
             Each banner carries its own top margin so hidden banners add no space. -->
        <StackPanel MaxWidth="640">
          <views:FeedbackBanner DataContext="{Binding Notice}" Margin="0,20,0,0" />
          <Border Classes="banner warning" Margin="0,20,0,0" IsVisible="{Binding Workspace.PlatformProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Classes="bannerMessage" Text="{Binding Workspace.PlatformProblem}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="banner warning" Margin="0,20,0,0" IsVisible="{Binding !Workspace.SelectedMonitor.IsControllable, FallbackValue=False}">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Workspace.SelectedMonitor.SupportTitle, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="bannerMessage" Text="{Binding Workspace.SelectedMonitor.SupportMessage, FallbackValue=''}" TextWrapping="Wrap" FontSize="{StaticResource Type.Caption}" />
            </StackPanel>
          </Border>
          <views:FeedbackBanner DataContext="{Binding Workspace.SelectedMonitor.Feedback}" Margin="0,20,0,0" />
        </StackPanel>

        <!-- Inputs and display controls share one centered column of fixed maximum width, so edges line
             up and banners wrap inside it instead of widening it. -->
        <StackPanel MaxWidth="{StaticResource Size.ContentColumn}" Margin="0,28,0,0">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12" IsVisible="{Binding Workspace.SelectedMonitor.IsControllable, FallbackValue=False}">
            <TextBlock Classes="overline" Text="INPUTS" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link" Margin="0,0,-6,0" Command="{Binding AddInputCommand}" AutomationProperties.Name="Add an input">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
                <TextBlock Text="Add input" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl x:Name="InputList" DataContext="{Binding Workspace.SelectedMonitor}" x:DataType="vm:MonitorViewModel"
                        ItemsSource="{Binding Inputs}" IsVisible="{Binding IsControllable}"
                        KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="12" LineSpacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InputCardViewModel">
                <Button Classes="inputCard" Classes.active="{Binding IsActive}"
                        Command="{Binding #InputList.((vm:MonitorViewModel)DataContext).SwitchToCommand, FallbackValue={x:Null}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        AutomationProperties.HelpText="Switches the monitor to this input">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="iconTile">
                        <controls:Icon Data="{Binding Icon, Converter={x:Static conv:IconConverters.ForInput}}" Width="22" Height="22" />
                      </Border>
                      <Button Grid.Column="2" Classes="subtle icon cardMenu" Width="30" Height="30" MinHeight="30" VerticalAlignment="Top" Margin="0,-4,-6,0"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).EditInputCommand, FallbackValue={x:Null}}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Customize"
                              AutomationProperties.Name="{Binding DisplayName, StringFormat='Customize {0}'}">
                        <controls:Icon Data="{StaticResource Icon.Edit}" Width="15" Height="15" />
                      </Button>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="1" Margin="0,0,0,10">
                      <TextBlock Classes="subtitle" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding PortCaption}" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding PortCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Height="22">
                      <Border Classes="liveChip" IsVisible="{Binding IsActive}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.TextOnAccent}" VerticalAlignment="Center" />
                          <TextBlock Text="Live" FontSize="{StaticResource Type.Overline}" FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSwitching}" VerticalAlignment="Center">
                        <controls:Spinner Width="12" Height="12" Foreground="{DynamicResource Brush.Accent}" IsVisible="{Binding IsSwitching}" />
                        <TextBlock Classes="caption" Text="Switching…" />
                      </StackPanel>
                      <views:Keycaps Grid.Column="1" ItemsSource="{Binding ShortcutParts}" VerticalAlignment="Center" />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding Workspace.SelectedMonitor.ShowNoInputs, FallbackValue=False}" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
            <TextBlock Classes="paragraph" TextAlignment="Center" MaxWidth="420"
                       Text="DisplaySwitch couldn't detect this monitor's inputs. Add them yourself; you can test each code before saving." />
            <Button Classes="secondary" HorizontalAlignment="Center" Command="{Binding AddInputCommand}" Content="Add an input" />
          </StackPanel>

          <TextBlock Classes="caption" HorizontalAlignment="Center" Margin="0,20,0,0"
                     IsVisible="{Binding Workspace.SelectedMonitor.HasInputs, FallbackValue=False}"
                     Text="{Binding Workspace.SelectedMonitor.KeyboardTip, FallbackValue=''}" />

          <!-- Display: brightness and color temperature, shown when the monitor supports either. -->
          <StackPanel DataContext="{Binding Workspace.SelectedMonitor.Picture, FallbackValue={x:Null}}" x:DataType="vm:PictureViewModel"
                      IsVisible="{Binding IsAvailable, FallbackValue=False}" Margin="0,32,0,0">
            <TextBlock Classes="overline" Text="DISPLAY" Margin="0,0,0,12" />
            <Border Classes="section" Padding="20,6">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,150,*,64" MinHeight="48" IsVisible="{Binding HasBrightness}">
                  <controls:Icon Data="{StaticResource Icon.Brightness}" Width="20" Height="20" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="Brightness" FontWeight="Medium" VerticalAlignment="Center" />
                  <Slider Grid.Column="2" Classes="picture" Maximum="{Binding BrightnessMaximum}" Value="{Binding Brightness}"
                          AutomationProperties.Name="Brightness" />
                  <TextBlock Grid.Column="3" Classes="sliderValue" Text="{Binding BrightnessLabel}" />
                </Grid>
                <Border Classes="divider" IsVisible="{Binding HasColorTemperature}" />
                <Grid ColumnDefinitions="Auto,150,*,64" MinHeight="48" IsVisible="{Binding HasColorTemperature}">
                  <controls:Icon Data="{StaticResource Icon.Temperature}" Width="20" Height="20" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="Color temperature" FontWeight="Medium" VerticalAlignment="Center" />
                  <Panel Grid.Column="2">
                    <Border Classes="temperatureTrack" />
                    <Slider Classes="picture temperature" Maximum="{Binding ColorTemperatureMaximum}" Value="{Binding ColorTemperature}"
                            AutomationProperties.Name="Color temperature" AutomationProperties.HelpText="Left is warmer, right is cooler" />
                  </Panel>
                  <TextBlock Grid.Column="3" Classes="sliderValue" Text="{Binding ColorTemperatureLabel}" />
                </Grid>
              </StackPanel>
            </Border>
            <views:FeedbackBanner DataContext="{Binding Feedback}" Margin="0,12,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
