<!--
  Component styles built only from Design/Tokens.axaml. Views pick a role through a class
  ("primary", "inputCard", "caption") instead of setting colors or sizes inline.

  Motion: transitions are declared under ".animated", a class the window root carries only when
  neither the OS nor the user asked for reduced motion. Durations: 120 ms (hover), 200 ms (state).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DisplaySwitch.App.Controls">

  <!-- ============================== Base ============================== -->
  <!-- Inter's contextual alternates turn "0x11" into "0×11"; input codes appear throughout the UI. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontFeatures" Value="-calt" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- One focus ring for every focusable control: 2 px, offset from the edge, in the focus color. -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource Brush.Focus}" CornerRadius="{StaticResource Radius.Tile}" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Custom title bar: the window title is drawn by the app's own header, and the app has no full-screen mode. -->
  <!-- The panel's own visibility is set by the decorations template (which outranks styles), so hide its text. -->
  <Style Selector="Panel#PART_TitleTextPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================ Typography ============================ -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{StaticResource Type.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource Type.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{StaticResource Type.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="{StaticResource Type.Overline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.paragraph">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <!-- ============================== Buttons ============================== -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="MinHeight" Value="{StaticResource Size.MinTouchTarget}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
  </Style>

  <!-- Square icon-only button. Always pair with ToolTip.Tip and AutomationProperties.Name. -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon controls|Icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
  </Style>

  <!-- ============================ Input card ============================ -->
  <Style Selector="Button.inputCard">
    <Setter Property="Width" Value="{StaticResource Size.InputCardWidth}" />
    <Setter Property="Height" Value="{StaticResource Size.InputCardHeight}" />
    <Setter Property="Padding" Value="{StaticResource Space.CardPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource Brush.Focus}" CornerRadius="17" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Card"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource Elevation.Card}"
                ClipToBounds="False">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.inputCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
  </Style>
  <Style Selector="Button.inputCard:pointerover /template/ Border#PART_Card">
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation.CardHover}" />
  </Style>
  <Style Selector="Button.inputCard:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
  </Style>
  <Style Selector="Button.inputCard.active">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="15" />
  </Style>
  <Style Selector="Button.inputCard:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Icon tile inside a card: neutral by default, filled with the accent when the input is live. -->
  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="{StaticResource Size.IconTile}" />
    <Setter Property="Height" Value="{StaticResource Size.IconTile}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.inputCard.active Border.iconTile">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>

  <!-- Motion is only declared under .animated (see header). -->
  <Style Selector=".animated Button.inputCard">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=".animated Button.inputCard:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>
  <Style Selector=".animated Button.inputCard:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>
  <Style Selector=".animated Border.iconTile">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <!-- "Live" status chip -->
  <Style Selector="Border.liveChip">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="8,2,9,2" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>

  <!-- ============================== Keycaps ============================== -->
  <Style Selector="Border.keycap">
    <Setter Property="Background" Value="{DynamicResource Brush.Keycap}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.KeycapStroke}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Border.keycap > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Type.Overline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================ Brand ============================ -->
  <!-- The logo badge keeps its brand gradient in every theme, like a printed logo. -->
  <Style Selector="Border.logoBadge">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#7B6CFF" />
        <GradientStop Offset="1" Color="#3D74F5" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>

  <!-- ============================ Surfaces ============================ -->
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Stroke}" />
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Sheet}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation.Overlay}" />
  </Style>

  <!-- ========================= Status banners ========================= -->
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.AccentText}" />
  </Style>
  <Style Selector="Border.banner.success">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
  </Style>
  <Style Selector="Border.banner.warning">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="Border.banner TextBlock.bannerMessage">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- ===================== Segmented control (RadioButtons) ===================== -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="MinWidth" Value="76" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Segment" Background="Transparent" CornerRadius="6" Padding="12,0">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation.Card}" />
  </Style>

  <!-- ============================== Icon picker ============================== -->
  <Style Selector="RadioButton.iconChoice">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Choice" Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="{StaticResource Radius.Tile}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.iconChoice:pointerover /template/ Border#PART_Choice">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
  </Style>
  <Style Selector="RadioButton.iconChoice:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
  </Style>
  <Style Selector="RadioButton.iconChoice:checked /template/ Border#PART_Choice">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>

  <!-- ============================== Form fields ============================== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Spinners animate only while their own IsVisible is true (a running animation on a hidden
       control keeps the render loop busy), so each spinner must bind IsVisible itself. -->
  <Style Selector="controls|Spinner">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
  </Style>
  <Style Selector=".animated controls|Spinner[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ============================== Picture sliders ============================== -->
  <Style Selector="Slider.picture">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="SmallChange" Value="1" />
    <Setter Property="LargeChange" Value="10" />
    <Setter Property="TickFrequency" Value="1" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The temperature track is drawn by a gradient behind the slider, so the slider's own track is hidden. -->
  <Style Selector="Slider.temperature /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Slider.temperature /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.temperatureTrack">
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Offset="0" Color="#FF9A3D" />
        <GradientStop Offset="0.5" Color="#F4EFE6" />
        <GradientStop Offset="1" Color="#7DB2FF" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="TextBlock.sliderValue">
    <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Thin progress line used while a switch is in flight. -->
  <Style Selector="ProgressBar.hairline">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
  </Style>
</Styles>
