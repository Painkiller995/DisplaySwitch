<!--
  DisplaySwitch icon set: original 24×24 line icons drawn for stroke rendering (1.6 px, round caps
  and joins, no fill) so every glyph shares one visual weight. Render them with the "Icon" Path style.
  Dots are zero-length segments ("h.01") that round caps turn into circles.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Devices: one per InputIcon value -->
  <StreamGeometry x:Key="Icon.Port">M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14 M3.5 12h11 M11 8.5 14.5 12 11 15.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Desktop">M4.5 4h15A1.5 1.5 0 0 1 21 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 14.5v-9A1.5 1.5 0 0 1 4.5 4z M12 16v4 M8 20h8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Laptop">M5.5 5h13A1.5 1.5 0 0 1 20 6.5V16H4V6.5A1.5 1.5 0 0 1 5.5 5z M4 16 2.5 19h19L20 16</StreamGeometry>
  <StreamGeometry x:Key="Icon.GameConsole">M7.5 8h9a4 4 0 0 1 3.9 3.1l.9 4.1a2.4 2.4 0 0 1-4.1 2.1l-1.7-1.8h-7l-1.7 1.8a2.4 2.4 0 0 1-4.1-2.1l.9-4.1A4 4 0 0 1 7.5 8z M8 10.5v3 M6.5 12h3 M15.5 11.5h.01 M17.5 13h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.MediaPlayer">M4.5 5h15A1.5 1.5 0 0 1 21 6.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5v-10A1.5 1.5 0 0 1 4.5 5z M8 21h8 M10.5 9v5l4-2.5z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tablet">M7 3h10a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 17 21H7a1.5 1.5 0 0 1-1.5-1.5v-15A1.5 1.5 0 0 1 7 3z M11 18h2</StreamGeometry>
  <StreamGeometry x:Key="Icon.Camera">M4.5 7h3L9 5h6l1.5 2h3A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-9A1.5 1.5 0 0 1 4.5 7z M12 10a3 3 0 1 0 0 6 3 3 0 0 0 0-6z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Dock">M5 14h14a1.5 1.5 0 0 1 1.5 1.5v2A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5v-2A1.5 1.5 0 0 1 5 14z M9 14V5h6v9 M7.5 16.5h3</StreamGeometry>

  <!-- Interface -->
  <StreamGeometry x:Key="Icon.Logo">M4.5 4.5h15A1.5 1.5 0 0 1 21 6v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 15V6a1.5 1.5 0 0 1 1.5-1.5z M9 20h6 M8.5 9h7l-2-2 M15.5 12h-7l2 2</StreamGeometry>
  <StreamGeometry x:Key="Icon.Settings">M4 7h10 M18 7h2 M16 5v4 M4 17h2 M10 17h10 M8 15v4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Refresh">M20 11a8 8 0 0 0-14.3-4.9L4 8 M4 4v4h4 M4 13a8 8 0 0 0 14.3 4.9L20 16 M20 20v-4h-4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Edit">M15.5 4.5l4 4L9 19H5v-4z M13.5 6.5l4 4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Check">M5 12.5 9.5 17 19 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">M6 6l12 12 M18 6 6 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Back">M15 5l-7 7 7 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Forward">M9 5l7 7-7 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12 5v14 M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Keyboard">M4.5 6h15A1.5 1.5 0 0 1 21 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5v-9A1.5 1.5 0 0 1 4.5 6z M7 10h.01 M10 10h.01 M13 10h.01 M16 10h.01 M8 14h8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Folder">M3.5 6.5A1.5 1.5 0 0 1 5 5h4l2 2h8a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Brightness">M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M12 2.5v2 M12 19.5v2 M5.3 5.3l1.4 1.4 M17.3 17.3l1.4 1.4 M2.5 12h2 M19.5 12h2 M5.3 18.7l1.4-1.4 M17.3 6.7l1.4-1.4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Temperature">M14 14.5V5a2 2 0 1 0-4 0v9.5a4 4 0 1 0 4 0z M12 9v7.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Info">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 11v5 M12 8h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Warning">M12 4 2.8 19.5h18.4z M12 10v4 M12 17h.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Error">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M9 9l6 6 M15 9l-6 6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Success">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M8 12.5l2.7 2.7L16 10</StreamGeometry>
</ResourceDictionary>
